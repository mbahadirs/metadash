{
  "name": "metadash",
  "productName": "MetaDash",
  "version": "2.0.0",
  "description": "Local-first desktop analytics for Instagram accounts and Meta Ads — for agencies managing many accounts.",
  "license": "MIT",
  "author": "Bahadır Şahin <mbhdrshn@gmail.com>",
  "homepage": "https://github.com/mbahadirs/metadash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbahadirs/metadash.git"
  },
  "bugs": {
    "url": "https://github.com/mbahadirs/metadash/issues"
  },
  "main": "src/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --mac --win --linux && electron-rebuild -f -w better-sqlite3",
    "start": "npm run build:renderer && cross-env electron .",
    "seed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed.js",
    "seed:reset": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed.js --reset",
    "smoke": "npm run build:renderer && cross-env METADASH_SMOKE=1 electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "i18n:check": "node scripts/i18n-check.mjs",
    "cli": "cross-env electron . --cli",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:mac": "npm run build:renderer && electron-builder --mac && electron-rebuild -f -w better-sqlite3",
    "build:win": "npm run build:renderer && electron-builder --win && electron-rebuild -f -w better-sqlite3",
    "build:mac:notarized": "npm run build:renderer && electron-builder --mac --config.mac.notarize=true && electron-rebuild -f -w better-sqlite3",
    "build:linux": "npm run build:renderer && electron-builder --linux && electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "better-sqlite3": "^11.7.0",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  }
}
