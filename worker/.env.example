# Generated by MetaDash (Settings → Publishing → Self-hosted worker → Generate secret). Keep private.
MD_WORKER_SECRET=
# Encryption key for tokens at rest (>= 32 chars). Not stored in /data. Losing it = re-send tokens from the desktop.
MD_WORKER_DATA_KEY=
# Optional public https base URL (signed media links Meta can fetch). With Caddy: https://$MD_DOMAIN
MD_PUBLIC_URL=
MD_DOMAIN=
# 1 (default): re-check token scopes with Meta on receipt
MD_STRICT_SCOPES=1
# 1: trust X-Forwarded-For for rate limiting (only behind your own proxy)
MD_TRUST_PROXY=0
TZ=UTC
