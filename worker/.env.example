# Generated by MetaDash (Settings → Publishing → Self-hosted worker → Generate secret). Keep private.
MD_WORKER_SECRET=
# Encryption key for tokens at rest (>= 32 chars). Not stored in /data. Losing it = re-send tokens from the desktop.
MD_WORKER_DATA_KEY=
# Optional public https base URL (signed media links Meta can fetch). With Caddy: https://$MD_DOMAIN
MD_PUBLIC_URL=
MD_DOMAIN=
# 1 (default): re-check token scopes with Meta on receipt
MD_STRICT_SCOPES=1
# 1 (docker-compose default): rate-limit by the client address in X-Forwarded-For. Required behind Caddy
# (--profile https) or any reverse proxy, otherwise all clients share the proxy's address and one bad client locks
# everyone out. Only honoured when the connection comes from a private/loopback address (the proxy); the right-most
# public X-Forwarded-For entry is used, so clients cannot spoof it. Set 0 only if the worker is exposed directly.
MD_TRUST_PROXY=1
TZ=UTC
